---
// Hello World Homepage
// This is the main landing page following the constitution standards
// Built with Astro.js, TypeScript, and Tailwind CSS
// Following atomic component design principles
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Agent Template - Hello World</title>
    <meta name="description" content="A modern website template built with Astro.js, TypeScript, and Tailwind CSS following atomic component design principles." />
  </head>
  <body class="min-h-screen bg-gradient-to-br from-primary-50 to-secondary-50">
    <main class="container mx-auto px-4 py-8">
      <!-- Hero Section -->
      <section class="text-center py-16">
        <h1 class="text-4xl md:text-6xl font-bold text-primary-900 mb-6">
          Hello World! 🌍
        </h1>
        <p class="text-xl md:text-2xl text-secondary-600 mb-8 max-w-3xl mx-auto">
          Welcome to the Astro Agent Template - a modern, performant website template 
          built with Astro.js, TypeScript, and Tailwind CSS.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button class="bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors">
            Get Started
          </button>
          <button class="border-2 border-primary-600 text-primary-600 hover:bg-primary-600 hover:text-white font-semibold py-3 px-6 rounded-lg transition-colors">
            Learn More
          </button>
        </div>
      </section>

      <!-- Component Showcase Section -->
      <section class="py-16">
        <h2 class="text-3xl font-bold text-center text-secondary-900 mb-12">
          Component Architecture
        </h2>
        
        <!-- Atoms Section -->
        <div class="mb-16">
          <h3 class="text-2xl font-semibold text-secondary-800 mb-8 text-center">
            Atomic Components (Atoms)
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-white rounded-lg shadow-md p-6">
              <h4 class="text-lg font-semibold text-gray-800 mb-4">Button</h4>
              <p class="text-sm text-gray-600 mb-4">
                Basic building block for interactive elements with consistent styling and behavior.
              </p>
              <div class="space-y-2">
                <button class="bg-primary-600 text-white px-4 py-2 rounded text-sm">Primary</button>
                <button class="border border-primary-600 text-primary-600 px-4 py-2 rounded text-sm">Secondary</button>
              </div>
            </div>

            <div class="bg-white rounded-lg shadow-md p-6">
              <h4 class="text-lg font-semibold text-gray-800 mb-4">Input</h4>
              <p class="text-sm text-gray-600 mb-4">
                Form input component with validation states and accessibility features.
              </p>
              <div class="space-y-2">
                <input type="text" placeholder="Enter text..." class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
                <input type="email" placeholder="Email address" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
              </div>
            </div>

            <div class="bg-white rounded-lg shadow-md p-6">
              <h4 class="text-lg font-semibold text-gray-800 mb-4">Label</h4>
              <p class="text-sm text-gray-600 mb-4">
                Form label component with proper accessibility and styling.
              </p>
              <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Field Label</label>
                <label class="block text-sm font-medium text-gray-700">Required Field <span class="text-red-500">*</span></label>
              </div>
            </div>
          </div>
        </div>

        <!-- Molecules Section -->
        <div class="mb-16">
          <h3 class="text-2xl font-semibold text-secondary-800 mb-8 text-center">
            Molecular Components (Molecules)
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-white rounded-lg shadow-md p-6">
              <h4 class="text-lg font-semibold text-gray-800 mb-4">SearchForm</h4>
              <p class="text-sm text-gray-600 mb-4">
                Search form combining Input, Button, and Label atoms for search functionality.
              </p>
              <div class="flex gap-2">
                <input type="search" placeholder="Search..." class="flex-1 px-3 py-2 border border-gray-300 rounded text-sm" />
                <button class="bg-primary-600 text-white px-4 py-2 rounded text-sm">Search</button>
              </div>
            </div>

            <div class="bg-white rounded-lg shadow-md p-6">
              <h4 class="text-lg font-semibold text-gray-800 mb-4">NavigationItem</h4>
              <p class="text-sm text-gray-600 mb-4">
                Navigation item combining Button, Icon, and Label atoms for navigation.
              </p>
              <div class="space-y-2">
                <a href="#" class="block px-4 py-2 text-primary-600 hover:bg-primary-50 rounded text-sm">Home</a>
                <a href="#" class="block px-4 py-2 text-gray-600 hover:bg-gray-50 rounded text-sm">About</a>
              </div>
            </div>

            <div class="bg-white rounded-lg shadow-md p-6">
              <h4 class="text-lg font-semibold text-gray-800 mb-4">Card</h4>
              <p class="text-sm text-gray-600 mb-4">
                Card component combining Heading, content, and Button atoms for content display.
              </p>
              <div class="border border-gray-200 rounded p-4">
                <h5 class="font-semibold text-gray-800 mb-2">Card Title</h5>
                <p class="text-sm text-gray-600 mb-3">Card description text goes here.</p>
                <button class="text-primary-600 hover:text-primary-700 text-sm">Learn More</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Implementation Status -->
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-yellow-800 mb-4">
            🚧 Implementation Status
          </h3>
          <p class="text-yellow-700 mb-4">
            The components shown above are currently placeholder implementations. 
            They should be built out following the atomic component design principles 
            defined in the project constitution.
          </p>
          <div class="space-y-2 text-sm text-yellow-600">
            <p><strong>Next Steps:</strong></p>
            <ul class="list-disc list-inside space-y-1 ml-4">
              <li>Implement atomic components (atoms) with proper TypeScript interfaces</li>
              <li>Create molecular components (molecules) using the atoms</li>
              <li>Build organism components (organisms) using molecules</li>
              <li>Create page templates using organisms</li>
              <li>Add snapshot tests for all components</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Technology Stack Section -->
      <section class="py-16">
        <h2 class="text-3xl font-bold text-center text-secondary-900 mb-12">
          Technology Stack
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white rounded-lg shadow-md p-6 text-center">
            <div class="text-4xl mb-4">🚀</div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Astro.js</h3>
            <p class="text-sm text-gray-600">Modern static site generator with server-side rendering</p>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6 text-center">
            <div class="text-4xl mb-4">📘</div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">TypeScript</h3>
            <p class="text-sm text-gray-600">Strict type checking and enhanced developer experience</p>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6 text-center">
            <div class="text-4xl mb-4">🎨</div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Tailwind CSS</h3>
            <p class="text-sm text-gray-600">Utility-first CSS framework for rapid styling</p>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6 text-center">
            <div class="text-4xl mb-4">🧪</div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Snapshot Testing</h3>
            <p class="text-sm text-gray-600">Test-driven development with snapshot testing</p>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-secondary-900 text-white py-8 mt-16">
      <div class="container mx-auto px-4 text-center">
        <p class="text-secondary-300">
          Built with ❤️ using Astro.js, TypeScript, and Tailwind CSS
        </p>
        <p class="text-sm text-secondary-400 mt-2">
          Following atomic component design principles and modern web standards
        </p>
      </div>
    </footer>
  </body>
</html>
